{
  "name": "@attendance1978-wq/serverpro",
  "version": "1.2.0",
  "description": "Lightweight and fast Node.js framework for APIs and backend development",
  "main": "./index.js",
  "type": "module",

  "exports": {
    ".": "./index.js",
    "./server": "./server.js",
    "./router": "./router.js"
  },

  "bin": {
    "serverpro": "./index.js"
  },

  "files": [
    "index.js",
    "server.js",
    "router.js",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node tests/server.test.js",
    "check": "node --check index.js",
    "lint": "node --check *.js",
    "clean": "rm -rf node_modules package-lock.json",
    "prepare": "npm run check"
  },

  "keywords": [
    "server",
    "http",
    "https",
    "nodejs",
    "framework",
    "backend",
    "router",
    "middleware",
    "api",
    "rest",
    "lightweight",
    "fast",
    "webserver"
  ],

  "author": "attendance1978-wq",

  "license": "MIT",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/attendance1978-wq/Serverpro.git"
  },

  "homepage": "https://github.com/attendance1978-wq/Serverpro",

  "bugs": {
    "url": "https://github.com/attendance1978-wq/Serverpro/issues"
  },

  "engines": {
    "node": ">=18.0.0"
  },

  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
